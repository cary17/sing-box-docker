{
  "route": {
    "rules": [
      {
        "action": "sniff",
        "sniffer": [
          "http",
          "tls",
          "quic",
          "dns"
        ]
      },
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "Direct"
      },
      {
        "network": "icmp",
        "outbound": "Direct"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "Direct"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "rule_set": [
          "Claude",
          "JetBrains",
          "Gemini",
          "OpenAI"
        ],
        "outbound": "AI"
      },
      {
        "rule_set": [
          "Microsoft",
          "Google",
          "Meta",
          "X"
        ],
        "outbound": "US"
      },
      {
        "rule_set": [
          "Spotify"
        ],
        "outbound": "HK"
      },
      {
        "rule_set": [
          "Twitch",
          "Bahamut"
        ],
        "outbound": "Streaming Media"
      },
      {
        "rule_set": "PayPal",
        "outbound": "PayPal"
      },
      {
        "rule_set": [
          "Apple"
        ],
        "outbound": "GLOBAL"
      },
      {
        "rule_set": [
          "Geosite-CN"
        ],
        "outbound": "Direct"
      },
      {
        "action": "resolve",
        "server": "fakeip",
        "disable_cache": false,
        "disable_optimistic_cache": false,
        "match_only": true
      },
      {
        "rule_set": [
          "Geoip-CN"
        ],
        "outbound": "Direct"
      }
    ],
    "rule_set": [
      {
        "tag": "Geoip-CN",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/Loyalsoldier/geoip/release/srs/cn.srs",
        "update_interval": "12h",
        "http_client": "http_client_US"
      },
      {
        "tag": "Geosite-CN",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/lyc8503/sing-box-rules/rule-set-geosite/geosite-cn.srs",
        "update_interval": "12h",
        "http_client": "http_client_US"
      },
      {
        "tag": "PayPal",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-paypal.srs",
        "update_interval": "12h",
        "http_client": "http_client_US"
      },
      {
        "tag": "Bahamut",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-bahamut.srs",
        "update_interval": "12h",
        "http_client": "http_client_US"
      },
      {
        "tag": "Twitch",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-twitch.srs",
        "update_interval": "12h",
        "http_client": "http_client_US"
      },
      {
        "tag": "Apple",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-apple.srs",
        "update_interval": "12h",
        "http_client": "http_client_US"
      },
      {
        "tag": "Google",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-google.srs",
        "update_interval": "12h",
        "http_client": "http_client_US"
      },
      {
        "tag": "Claude",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-anthropic.srs",
        "update_interval": "12h",
        "http_client": "http_client_US"
      },
      {
        "tag": "Gemini",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-google-gemini.srs",
        "update_interval": "12h",
        "http_client": "http_client_US"
      },
      {
        "tag": "Microsoft",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-microsoft.srs",
        "update_interval": "12h",
        "http_client": "http_client_US"
      },
      {
        "tag": "OpenAI",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-openai.srs",
        "update_interval": "12h",
        "http_client": "http_client_US"
      },
      {
        "tag": "JetBrains",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-jetbrains-ai.srs",
        "update_interval": "12h",
        "http_client": "http_client_US"
      },
      {
        "tag": "Meta",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-meta.srs",
        "update_interval": "12h",
        "http_client": "http_client_US"
      },
      {
        "tag": "X",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-x.srs",
        "update_interval": "12h",
        "http_client": "http_client_US"
      },
      {
        "tag": "Spotify",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-spotify.srs",
        "update_interval": "12h",
        "http_client": "http_client_US"
      }
    ],
    "final": "FINAL",
    "default_domain_resolver": "local",
    "default_http_client": "default",
    "auto_detect_interface": true
  }
}