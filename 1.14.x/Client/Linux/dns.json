{
  "dns": {
    "servers": [
      {
        "type": "resolved",
        "tag": "resolved-dns",
        "service": "resolved-service",
        "accept_default_resolvers": true
      },
      {
        "type": "fakeip",
        "tag": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "domain_suffix": [
          "msftncsi.com",
          "msftconnecttest.com",
          "ntp.tencent.com"
        ],
        "action": "route",
        "server": "resolved-dns"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fakeip"
      }
    ],
    "final": "resolved-dns",
    "strategy": "prefer_ipv4",
    "optimistic": true,
    "reverse_mapping": false,
    "cache_capacity": 51200
  }
}